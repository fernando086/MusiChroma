<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar Informe"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genera un documento con los datos de esta sesión o de todo el grupo de sesiones vinculadas."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formato de exportación"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switchFormato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PDF"
            android:textOff="Word"
            android:textOn="PDF"
            android:showText="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alcance"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgAlcance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rbSoloSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar solo esta sesión"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbTodoGrupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar todo el grupo"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/chkPlantillaExtendida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incluir Anexo (institución, canciones, emociones, etc.)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGenerarReporte"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Generar Reporte"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4081"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
